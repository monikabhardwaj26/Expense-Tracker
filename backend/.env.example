# Copy this file to .env and fill in real values before running the server.
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Financial Advisor (backend-only — never exposed to React).
# Get a key from https://console.anthropic.com — check that dashboard for
# the current model names available to your account and set AI_MODEL_NAME
# to match (the default below may not match what your account can call).
AI_API_KEY=
AI_MODEL_NAME=claude-3-5-haiku-latest
